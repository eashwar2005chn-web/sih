<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:scrollbars="none"
    android:clipToPadding="false"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="14dp"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:animateLayoutChanges="true">

        <!-- CAPTURE -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        style="@style/SectionLabel"
                        android:text="@string/capture_status" />

                    <View
                        android:id="@+id/dotLive"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_dot_idle" />

                    <TextView
                        android:id="@+id/txtCaptureState"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="7dp"
                        android:text="Stopped"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/input_level" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <org.drdo.voicelogger.ui.widget.LevelMeterView
                        android:id="@+id/levelMeter"
                        android:layout_width="0dp"
                        android:layout_height="10dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/txtLevelDb"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="-60.0 dB"
                        android:textAlignment="viewEnd"
                        style="@style/Mono" />
                </LinearLayout>

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:text="@string/current_segment" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/segmentProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:trackCornerRadius="100dp"
                    app:trackThickness="6dp"
                    app:trackColor="@color/border"
                    app:indicatorColor="@color/blue_600"
                    android:max="1000"
                    android:progress="0" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/txtSegmentElapsed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--"
                        style="@style/Mono" />

                    <TextView
                        android:id="@+id/txtSegmentBuffered"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="--"
                        style="@style/Mono" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnToggleService"
                    style="@style/PrimaryButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="Start capture" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- STATS -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:baselineAligned="false">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/statTotal" style="@style/StatValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" />
                    <TextView style="@style/StatCaption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Entries" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/statQueued" style="@style/StatValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" />
                    <TextView style="@style/StatCaption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Queued" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView android:id="@+id/statSynced" style="@style/StatValue"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="0" />
                    <TextView style="@style/StatCaption"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Synced" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SYNC -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="18dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView style="@style/SectionLabel"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="@string/cloud_section" />

                    <TextView
                        android:id="@+id/txtSyncState"
                        style="@style/Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="No endpoint configured" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSyncNow"
                    style="@style/OutlineButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    app:icon="@drawable/ic_sync"
                    app:iconSize="16dp"
                    android:text="@string/sync_now" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- EMERGENCY -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:strokeColor="@color/danger"
            app:cardBackgroundColor="@color/danger_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp"
                android:gravity="center">

                <TextView
                    style="@style/SectionLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/danger"
                    android:text="@string/emergency" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSosEmergency"
                    android:layout_width="132dp"
                    android:layout_height="132dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:text="SOS"
                    android:textSize="27sp"
                    android:textStyle="bold"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    app:backgroundTint="@color/danger"
                    app:cornerRadius="66dp"
                    app:elevation="0dp" />

                <TextView
                    style="@style/StatCaption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAlignment="center"
                    android:text="@string/sos_hint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- DESTINATION -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView style="@style/SectionLabel"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="@string/storage_section" />

                <TextView
                    android:id="@+id/txtStorageDest"
                    style="@style/Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Internal storage" />

                <TextView
                    android:id="@+id/txtStorageUsed"
                    style="@style/Mono"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
